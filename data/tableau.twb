              <aliases>
                <alias key='true' value='T' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0474725240762368]' derivation='None' name='[none:Calculation_0474725240762368:nk]' pivot='key' type='nominal' />
            <column-instance column='[Clnt Age (bin)]' derivation='None' name='[none:Clnt Age (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[group]' derivation='None' name='[none:group:nk]' pivot='key' type='nominal' />
            <column-instance column='[made_error]' derivation='None' name='[none:made_error:nk]' pivot='key' type='nominal' />
            <column-instance column='[made_error]' derivation='Count' name='[pcto:cnt:made_error:qk]' pivot='key' type='quantitative'>
