          <datasource-dependencies datasource='federated.07m0o0j0wmw7nr10oswvk1snyx7b'>
            <column caption='Ages' datatype='string' name='[Calculation_0474725240762368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [clnt_age] &gt; 16.999 AND [clnt_age] &lt;= 31 THEN &quot;[17, 31]&quot;&#13;&#10;ELSEIF [clnt_age] &gt; 31 AND [clnt_age] &lt;= 42 THEN &quot;[31, 42]&quot;&#13;&#10;ELSEIF [clnt_age] &gt; 42 AND [clnt_age] &lt;= 53 THEN &quot;[42, 53]&quot;&#13;&#10;ELSEIF [clnt_age] &gt; 53 AND [clnt_age] &lt;= 62 THEN &quot;[53, 62]&quot;&#13;&#10;ELSEIF [clnt_age] &gt; 62 AND [clnt_age] &lt;= 96 THEN &quot;[62, 96]&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;(16.999, 31]&quot;' value='[17, 31]' />
              </aliases>
            </column>
            <column caption='Error rate' datatype='real' name='[Calculation_0890066120212482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(INT([made_error]))' />
            </column>
            <column caption='Clnt Age' datatype='real' name='[clnt_age]' role='measure' type='quantitative' />
